generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  OWNER
  MANAGER
  VIEWER
}
enum RentalMode {
  ROOMS
  WHOLE_PROPERTY
}
enum ResourceKind {
  ROOM
  WHOLE_PROPERTY
}
enum PaymentKind {
  PAYMENT
  REVERSAL
}
enum EntryMode {
  FULL_MONTH
  MANUAL_PARTIAL_PERIOD
}
model User {
  id String @id @default(uuid())
  email String @unique
  display_name String
  password_hash String
  role Role
  enabled Boolean @default(true)
  session_version Int @default(1)
  version Int @default(1)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  properties Property[]
  grants PropertyAccess[]
  requests IdempotencyRecord[]
}
model PropertyAccess {
  user_id String
  property_id String
  user User @relation(fields:[user_id],references:[id],onDelete:Cascade)
  property Property @relation(fields:[property_id],references:[id],onDelete:Cascade)
  @@id([user_id,property_id])
}
model Property {
  id String @id @default(uuid())
  name String
  city String
  address String
  owner_user_id String
  owner User @relation(fields:[owner_user_id],references:[id])
  rental_mode RentalMode
  version Int @default(1)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  resources Resource[]
  grants PropertyAccess[]
  documents Document[]
}
model Resource {
  id String @id @default(uuid())
  property_id String
  property Property @relation(fields:[property_id],references:[id])
  name String
  kind ResourceKind
  capacity Int
  version Int @default(1)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  contracts Contract[]
  @@index([property_id])
}
model Tenant {
  id String @id @default(uuid())
  name String
  email String?
  phone String?
  version Int @default(1)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  contracts Contract[]
  documents Document[]
}
model Contract {
  id String @id @default(uuid())
  tenant_id String
  tenant Tenant @relation(fields:[tenant_id],references:[id])
  resource_id String
  resource Resource @relation(fields:[resource_id],references:[id])
  start_date DateTime @db.Date
  end_date DateTime @db.Date
  termination_date DateTime? @db.Date
  monthly_rent_twd Decimal @db.Decimal(12,0)
  deposit_twd Decimal @db.Decimal(12,0)
  due_day Int @default(1)
  primary_document_id String? @unique
  primary_document Document? @relation("PrimaryDocument",fields:[primary_document_id],references:[id])
  version Int @default(1)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  documents Document[] @relation("ContractDocuments")
  obligations RentalObligation[]
  @@index([resource_id,start_date,end_date])
  @@index([tenant_id])
}
model RentalObligation {
  id String @id @default(uuid())
  contract_id String
  contract Contract @relation(fields:[contract_id],references:[id])
  period_start DateTime @db.Date
  period_end DateTime @db.Date
  due_date DateTime @db.Date
  amount_due_twd Decimal @db.Decimal(12,0)
  entry_mode EntryMode
  created_at DateTime @default(now())
  payments PaymentRecord[]
  @@unique([contract_id,period_start,period_end])
  @@index([due_date])
}
model PaymentRecord {
  id String @id @default(uuid())
  obligation_id String
  obligation RentalObligation @relation(fields:[obligation_id],references:[id])
  amount_twd Decimal @db.Decimal(12,0)
  kind PaymentKind
  reverses_payment_id String? @unique
  reverses PaymentRecord? @relation("Reversals",fields:[reverses_payment_id],references:[id])
  reversal PaymentRecord? @relation("Reversals")
  recorded_at DateTime @default(now())
  request_key String
  documents Document[]
  @@index([obligation_id])
}
model IdempotencyRecord {
  id String @id @default(uuid())
  principal_id String
  principal User @relation(fields:[principal_id],references:[id])
  operation String
  request_key String
  request_hash String
  response Json
  created_at DateTime @default(now())
  @@unique([principal_id,operation,request_key])
}
model Document {
  id String @id @default(uuid())
  kind String
  contract_id String?
  contract Contract? @relation("ContractDocuments",fields:[contract_id],references:[id])
  primary_for Contract? @relation("PrimaryDocument")
  payment_id String?
  payment PaymentRecord? @relation(fields:[payment_id],references:[id])
  tenant_id String?
  tenant Tenant? @relation(fields:[tenant_id],references:[id])
  property_id String
  property Property @relation(fields:[property_id],references:[id])
  file_name String
  file_type String
  mime_type String
  size_bytes Int
  uploaded_at DateTime @default(now())
  sha256 String
  content DocumentContent?
  @@index([property_id,contract_id,tenant_id])
}
model DocumentContent {
  document_id String @id
  document Document @relation(fields:[document_id],references:[id],onDelete:Cascade)
  bytes Bytes
}
model DemoContext {
  id String @id @default("singleton")
  business_date DateTime @db.Date
}
